# --- required ---------------------------------------------------------------
# Helius mainnet RPC. The websocket URL is derived from it automatically.
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# The LAUNCH wallet: the one that sends the relaunches. `npm run keygen` makes
# one and fills this in, printing only the address to fund. The developer
# wallet you copy is set in the dashboard and never needs its key.
# Also accepts your own: a base58 secret key (Phantom export), a JSON byte
# array (solana-keygen), or a path to a solana-keygen JSON file.
WALLET_PRIVATE_KEY=

# --- dashboard / API --------------------------------------------------------
# Where `npm run serve` listens. Keep 127.0.0.1 on your own machine; use
# 0.0.0.0 plus an API_TOKEN (and HTTPS in front) when hosting it elsewhere.
HOST=127.0.0.1
PORT=3210
# When set, the website and the extension must send this token.
API_TOKEN=
# Developer wallet, settings and run history are kept here.
DATA_DIR=data

# --- relaunch policy (optional; editable live in the dashboard) -------------
# How many times to relaunch after the first launch.
RELAUNCH_MAX=3
# Seconds each launch gets to attract buys before the next relaunch.
RELAUNCH_INTERVAL_SEC=120
# Seconds between bonding-curve checks inside that window.
RELAUNCH_POLL_SEC=10
# Stop relaunching once the current coin has this many buys from wallets other
# than the launch wallet. 0 = never stop early (always run all relaunches).
RELAUNCH_STOP_ON_BUYS=1
# Copy a detected launch immediately instead of first watching the original
# for buys (true/false).
INSTANT_COPY=true

# --- launch options ---------------------------------------------------------
# SOL to buy in the same transaction as the create (0 = create only).
DEV_BUY_SOL=0
# Priority fee in micro-lamports per compute unit.
PRIORITY_FEE_MICROLAMPORTS=500000
# Send through a Jito block engine instead of the RPC (leave empty to use the RPC).
# e.g. https://frankfurt.mainnet.block-engine.jito.wtf
JITO_URL=
# Tip in SOL added to each launch transaction when JITO_URL is set.
JITO_TIP_SOL=0.001
# Build and simulate the launch transaction but never send it (true/false).
DRY_RUN=false
# OTC launcher coins (otcdesks.cash): re-upload the metadata so the copy's
# website link is its own OTC page instead of the original's (true/false;
# about a second slower per copy).
OTC_OWN_PAGE=true
